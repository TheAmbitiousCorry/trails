{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TRAILS_CONTEXT_FORMAT=hook-json \"$CLAUDE_PROJECT_DIR/.trail/hooks/trails-session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.trail/hooks/trails-pre-read.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "TRAILS_CONTEXT_FORMAT=hook-json \"$CLAUDE_PROJECT_DIR/.trail/hooks/trails-edited.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "TRAILS_CONTEXT_FORMAT=hook-json \"$CLAUDE_PROJECT_DIR/.trail/hooks/trails-bash-read.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TRAILS_BLOCK_FORMAT=block \"$CLAUDE_PROJECT_DIR/.trail/hooks/trails-stop.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TRAILS_CONTEXT_FORMAT=hook-json \"$CLAUDE_PROJECT_DIR/.trail/hooks/trails-subagent-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TRAILS_BLOCK_FORMAT=block \"$CLAUDE_PROJECT_DIR/.trail/hooks/trails-stop.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
